---
/**
 * Marquee.astro — oranje band met schuivende namen uit het menu.
 *
 * De band is sier: de visuele rail is aria-hidden en een `.sr-only`-zin noemt de items
 * een keer in gewone taal. Zo hoort een schermlezer de lijst niet twee keer en niet in
 * stukjes.
 *
 * WCAG 2.2.2 (Pause, Stop, Hide): de animatie duurt langer dan vijf seconden en loopt
 * door, dus er is een zichtbare pauzeknop van 48px. De band pauzeert ook op :hover.
 * Onder `prefers-reduced-motion: reduce` staat de band stil en verdwijnt de knop
 * (motion.css) — er is dan niets om te pauzeren.
 *
 * De track bevat twee identieke groepen en schuift naar -50%: dat landt exact op de
 * naad, dus de lus is onzichtbaar. Een groep moet daarvoor breder zijn dan het breedste
 * scherm, anders zie je gat na de laatste naam. De items worden daarom herhaald tot de
 * geschatte groepsbreedte boven MIN_GROUP_WIDTH uitkomt.
 */
interface Props {
  items: string[];
  /** Duur van een volledige lus in seconden. Lager = sneller. */
  duration?: number;
  /** Andersom laten lopen (de tweede band op de homepage). */
  reverse?: boolean;
  /** De zin voor schermlezers. Zonder deze prop wordt alleen de lijst opgesomd. */
  srLabel?: string;
}

const { items, duration = 40, reverse = false, srLabel } = Astro.props;

/** Breder dan het breedste gangbare scherm, met marge. */
const MIN_GROUP_WIDTH = 1600;
/** Grove schatting per item: Oswald 700 op ~1.3rem, plus scheidingsteken en gap. */
const PX_PER_CHAR = 13;
const PX_PER_ITEM_CHROME = 64;

const groupWidth = items.reduce(
  (total, item) => total + item.length * PX_PER_CHAR + PX_PER_ITEM_CHROME,
  0
);
const repeats = groupWidth > 0 ? Math.max(1, Math.ceil(MIN_GROUP_WIDTH / groupWidth)) : 1;

/** Een groep = de items, zo vaak herhaald dat de rij breder is dan het scherm. */
const groupItems = Array.from({ length: repeats }, () => items).flat();

const sentence = srLabel ?? `${items.join(', ')}.`;
---

<div class:list={['marquee', { 'marquee--reverse': reverse }]} style={`--marquee-duration:${duration}s`} data-marquee>
  <p class="sr-only">{sentence}</p>

  <div class="marquee__track" aria-hidden="true">
    {
      /* Twee identieke groepen: -50% op de track landt exact op de naad. */
      [0, 1].map(() => (
        <ul class="marquee__group">
          {
            groupItems.map((item) => (
              <>
                <li class="marquee__item">{item}</li>
                <li class="marquee__sep">&#183;</li>
              </>
            ))
          }
        </ul>
      ))
    }
  </div>

  <button type="button" class="marquee__pause" aria-pressed="false" aria-label="Pauzeer animatie">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true" focusable="false">
      <rect class="marquee__icon-pause" x="3.5" y="2.5" width="4" height="13" rx="1"></rect>
      <rect class="marquee__icon-pause" x="10.5" y="2.5" width="4" height="13" rx="1"></rect>
      <path class="marquee__icon-play" d="M4.5 2.8 15 9 4.5 15.2Z" hidden></path>
    </svg>
  </button>
</div>

<script>
  /**
   * Een script voor alle marquees op de pagina (Astro bundelt dit bestand een keer,
   * hoe vaak de component ook staat). De knop schakelt `data-paused` op de band; de
   * animatie zelf wordt in motion.css gepauzeerd.
   */
  const marquees = document.querySelectorAll<HTMLElement>('[data-marquee]');

  for (const marquee of marquees) {
    const button = marquee.querySelector<HTMLButtonElement>('.marquee__pause');
    if (!button) continue;

    const pauseIcons = button.querySelectorAll<SVGElement>('.marquee__icon-pause');
    const playIcon = button.querySelector<SVGElement>('.marquee__icon-play');

    button.addEventListener('click', () => {
      const paused = marquee.dataset.paused !== 'true';
      marquee.dataset.paused = String(paused);
      button.setAttribute('aria-pressed', String(paused));
      // Het label volgt de actie die de knop NU uitvoert, niet de huidige staat.
      button.setAttribute('aria-label', paused ? 'Speel animatie' : 'Pauzeer animatie');
      for (const icon of pauseIcons) icon.toggleAttribute('hidden', paused);
      playIcon?.toggleAttribute('hidden', !paused);
    });
  }
</script>
